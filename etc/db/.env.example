# Copy to .env and replace the password before starting anything.
#
# Generate one, do not invent one:
#   openssl rand -base64 24 | tr -d '/+=' | cut -c1-32
#
# The role is not called "postgres" on purpose: naming it something else defeats the
# credential spray that every exposed PostgreSQL port receives within hours.
POSTGRES_USER=nurgling_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=nurgling_db

# Published port. Not 5432, which keeps automated scanners quieter.
PGPORT=5436
